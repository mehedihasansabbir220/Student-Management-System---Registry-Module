# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms?schema=public"
# Separate database for integration tests (wiped by the test suite)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_test?schema=public"
# Where uploaded submissions are stored (relative to project root)
UPLOAD_DIR="./uploads"
# Maximum upload size in megabytes
MAX_UPLOAD_MB="10"
# debug | info | warn | error
LOG_LEVEL="info"
# Optional: also append JSON logs to this file (leave empty to log to stdout only)
LOG_FILE="./logs/app.log"
